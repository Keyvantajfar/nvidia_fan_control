#!/usr/bin/env python3
"""Wrapper CLI for the NVIDIA Fan Control V2 daemon.

This command provides convenient access to journald logs, the curses
reconfiguration UI, and systemd helpers. Runtime configuration is now loaded
directly from the INI file so no rebuild step is required."""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path
from typing import List, Optional

CONFIG_PATH = "/etc/nvidia-fan-controlV2.conf"
LIBEXEC_DIR_DEFAULT = "/usr/local/lib/nvidia-fan-control"
SERVICE_NAME = "nvidia-fan-controlV2"
DAEMON_INSTALL_PATH = "/usr/local/sbin/nvidia_fan_controlV2d"


class CLIError(Exception):
    pass


def libexec_dir() -> Path:
    override = os.environ.get("NVFC_LIBEXEC_DIR")
    base = Path(override) if override else Path(LIBEXEC_DIR_DEFAULT)
    return base


def run_command(cmd: List[str], *, check: bool = True, env: Optional[dict] = None) -> int:
    result = subprocess.run(cmd, env=env)
    if check and result.returncode != 0:
        raise CLIError(f"Command failed: {' '.join(cmd)}")
    return result.returncode


def restart_service() -> None:
    run_command(["systemctl", "restart", SERVICE_NAME])


def show_status() -> None:
    run_command(["systemctl", "status", SERVICE_NAME], check=False)


def tail_logs() -> None:
    run_command(["journalctl", "-u", SERVICE_NAME, "-f", "-o", "cat"], check=False)


def run_tui() -> int:
    script = libexec_dir() / "nvfc_tui.py"
    if not script.exists():
        raise CLIError(f"Required helper not found: {script}")
    env = os.environ.copy()
    env.setdefault("NVFC_PARENT_CLI", str(Path(sys.argv[0]).resolve()))
    return run_command(["python3", str(script), "--config", CONFIG_PATH], check=False, env=env)


def reload_service() -> None:
    run_command(["systemctl", "reload", SERVICE_NAME])


def parse_args(argv: List[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="NVIDIA Fan Control V2 management CLI")
    parser.add_argument("--re-configure", action="store_true", dest="reconfigure", help="Run the TUI, save config, and reload")
    parser.add_argument("--status", action="store_true", help="Show systemd service status")
    parser.add_argument("--restart", action="store_true", help="Restart the systemd service")
    parser.add_argument("--apply", action="store_true", help="Reload the daemon configuration without running the TUI")
    return parser.parse_args(argv)


def main(argv: List[str]) -> int:
    args = parse_args(argv)

    if not any([args.reconfigure, args.status, args.restart, args.apply]) and argv:
        # Some other argument provided (argparse would have raised). Should not happen.
        pass

    try:
        if not any([args.reconfigure, args.status, args.restart, args.apply]):
            tail_logs()
            return 0
        if args.status:
            show_status()
        if args.restart:
            restart_service()
        if args.apply:
            reload_service()
        if args.reconfigure:
            ret = run_tui()
            if ret != 0:
                print("Reconfiguration cancelled or failed; no changes applied.")
                return ret
            reload_service()
        return 0
    except CLIError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
